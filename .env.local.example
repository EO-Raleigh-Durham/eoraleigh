# EO Chapter Manager settings. Copy to .env.local (never commit .env.local)
# and fill in. README.md says where each value comes from. The same values go
# into Vercel > Project > Settings > Environment Variables.

# ---------------------------------------------------------------- required
# Your chapter
# full name, e.g. "EO Berlin" (quote it: "EO Berlin")
NEXT_PUBLIC_ORG_NAME=
# short label for tight spaces, e.g. EOBER
NEXT_PUBLIC_CHAPTER_SHORT_NAME=
# lowercase-with-dashes id, e.g. eo-berlin
NEXT_PUBLIC_CHAPTER_SLUG=
# main city, e.g. Berlin
NEXT_PUBLIC_CHAPTER_CITY=
# e.g. Germany
NEXT_PUBLIC_CHAPTER_COUNTRY=
# ISO two-letter code, e.g. DE
NEXT_PUBLIC_CHAPTER_COUNTRY_CODE=
# IANA zone, e.g. Europe/Berlin
NEXT_PUBLIC_CHAPTER_TIME_ZONE=
# shown next to times, e.g. CET
NEXT_PUBLIC_CHAPTER_TIME_ZONE_LABEL=
# public address, no trailing slash, e.g. https://www.eoberlin.org
NEXT_PUBLIC_SITE_URL=
# public contact address, e.g. hello@eoberlin.org
NEXT_PUBLIC_SUPPORT_EMAIL=

# Supabase (README Step 2)
# https://<project-ref>.supabase.co
SUPABASE_URL=
# same as SUPABASE_URL
NEXT_PUBLIC_SUPABASE_URL=
# the "anon" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# the sb_publishable_ key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# the sb_secret_ key (CLI: --reveal) or the service_role key. Server only
SUPABASE_SECRET_KEY=
# session pooler connection string, used only by scripts/setup-db.mjs
SUPABASE_DB_URL=

# Random secrets: generate each with `openssl rand -hex 32`
CRON_SECRET=
UNSUBSCRIBE_SECRET=
RSVP_ANTISPAM_SECRET=
MCP_RECEIPT_SECRET=

# ---------------------------------------------------------------- optional
# Who gets notices (blank = the first ADMIN_EMAILS address)
# comma separated staff addresses
ADMIN_EMAILS=
OPS_EMAIL=
BOARD_NOTIFY_EMAIL=
DUES_NOTIFY_EMAIL=
EVENTS_EMAIL=
ACCOUNTING_EMAIL=
NEXT_PUBLIC_CHAPTER_MANAGER_EMAIL=
NEXT_PUBLIC_CHAPTER_BOARD_EMAIL=
NEXT_PUBLIC_CHAPTER_PARTNERS_EMAIL=
NEXT_PUBLIC_CHAPTER_PRIVACY_EMAIL=
NEXT_PUBLIC_CHAPTER_MARKETING_EMAIL=
# shown in the cancellation policy
NEXT_PUBLIC_CHAPTER_MANAGER_NAME=
# e.g. +4915550100
NEXT_PUBLIC_CHAPTER_MANAGER_WHATSAPP=
# e.g. WhatsApp; blank hides the mention
NEXT_PUBLIC_CHAPTER_CHAT_APP=
# link for the footer; blank hides it
NEXT_PUBLIC_CHAPTER_CHAT_URL=
# cities on the join form, comma separated; blank = free text
NEXT_PUBLIC_CHAPTER_CITIES=
# e.g. "+49 ..."
NEXT_PUBLIC_CHAPTER_PHONE_PLACEHOLDER=
# e.g. "+49 151 2345 6789"
NEXT_PUBLIC_CHAPTER_PHONE_EXAMPLE=

# Money: prices are in USD; a second local currency is optional
# e.g. EUR; blank = USD only
NEXT_PUBLIC_CHAPTER_LOCAL_CURRENCY=
# fixed planning rate for dashboards, e.g. 0.92
NEXT_PUBLIC_CHAPTER_LOCAL_PER_USD=

# Email (Resend). Without it, tickets show on screen and no email is sent
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# e.g. "EO Berlin <hello@eoberlin.org>"
# EMAIL_FROM=
# EVENT_FROM_EMAIL=
# MARKETING_EMAIL_FROM=
# MARKETING_REPLY_TO=
# MARKETING_NOTIFY_EMAIL=
# required by law in marketing email footers
# MARKETING_POSTAL_ADDRESS=
# EMAIL_SIGN_OFF=

# Payments (Stripe). Without it, paid tickets and dues are switched off
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Board assistant (Anthropic) and image generation
# ANTHROPIC_API_KEY=
# chatbot_reader connection string (README, optional steps)
# CHATBOT_DB_URL=
# CHATBOT_MODEL=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Vercel Web Analytics on the board's marketing pages
# VERCEL_ANALYTICS_TOKEN=
# VERCEL_ANALYTICS_TEAM_ID=
# VERCEL_ANALYTICS_PROJECT_ID=

# Lark (Feishu) notices and file uploads, if your chapter uses Lark
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_REVENUE_FOLDER_TOKEN=
# LARK_OPS_WEBHOOK_URL=
# LARK_MARKETING_WEBHOOK_URL=

# Public demo site only. NEVER set these on a real chapter: they show sign-ins
# on the login page to anyone. Each is "email|password".
# NEXT_PUBLIC_DEMO_MEMBER_LOGIN=
# NEXT_PUBLIC_DEMO_BOARD_LOGIN=
# Link back to the demo's landing page from the in-app demo guide
# NEXT_PUBLIC_DEMO_HOME_URL=

# Pre-launch access code: while set, every page asks for it first (src/lib/site-gate.ts).
# Leave empty to open the site. Changing it signs everyone out of the gate.
SITE_ACCESS_CODE=
