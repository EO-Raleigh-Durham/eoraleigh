# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit any .env file. Real values live only in
# .env.local (which is gitignored). Document required vars in .env.local.example.
.env*
!.env.local.example

# vercel
.vercel

# claude code (worktrees, session caches)
.claude/

# local scratch dir for working/draft images that aren't shipped
context/working-images/

# supabase cli local cache
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts

# EO Raleigh Durham: this fork is public. Keep private working files in
# private/ and never commit exports, spreadsheets or backups (see CHAPTER.md).
/private/
*.csv
*.tsv
*.xls
*.xlsx
*.numbers
*.ods
*.vcf
*.mbox
*.eml
*.dump
*.backup
*.bak
*.sqlite
*.sqlite3
*.db
